{
  "name": "Peters Kasse",
  "short_name": "Kasse",
  "description": "Lokale Touch-Kasse fuer Verkauf, Bons, Rabatte und Adminverwaltung.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "browser"],
  "orientation": "landscape",
  "background_color": "#f1f3f6",
